#!/bin/sh
# Repository-local command dispatcher: the canonical ./scrooge-alert interface.
#
# Standalone by design. This is the one executable in the project that sources
# nothing from scripts/lib, so it repeats common.sh's color detection and
# command_text and inlines the two symlink guards noted below. Sourcing
# common.sh would make even ./scrooge-alert --help depend on HOME (through
# SYSTEMD_USER_DIR), export a DEBUG_MODE into every owner's environment, and
# require the whole lib set to be intact -- in the one script whose job includes
# reporting a missing or unsafe owner in a damaged checkout. The duplication is
# the price of that independence; do not collapse it into a shared helper.

set -eu

BASE_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" >/dev/null 2>&1 && pwd)"
if [ -z "${NO_COLOR:-}" ] && { [ -t 1 ] || [ -n "${CLICOLOR_FORCE:-}" ]; }; then
    COMMAND_COLOR='\033[1;36m'
    NC='\033[0m'
else
    COMMAND_COLOR=''
    NC=''
fi

command_text() {
    printf '%b%s%b' "$COMMAND_COLOR" "$1" "$NC"
}

print_help() {
    printf '\n'
    printf '%s\n' "Usage: ./scrooge-alert <command> [options]"
    printf '\n'
    printf '%s\n' "Commands:"
    printf '  %-13s%s\n' \
        run "Check prices for tracked items" \
        ping "Send a test notification" \
        status "Inspect configuration and service health" \
        install "Install or reprovision targets" \
        enable "Enable and start target timers" \
        disable "Stop and disable target timers" \
        stop "Stop running target services" \
        schedule "Apply configured target schedules" \
        update "Update this checkout" \
        uninstall "Remove installed targets or this installation"
    printf '\n'
    printf '%s\n' "Options:"
    printf '%s\n' \
        "  -h, --help   Show this help message and exit" \
        "  --version    Show the installed release version and exit"
    printf '\n'
}

fail_usage() {
    printf '\n%s\n' "Error: $1" >&2
    printf '%s\n' "Run $(command_text './scrooge-alert --help') for usage." >&2
    printf '\n' >&2
    exit 1
}

# --version is informational and must never fail, so every way of not knowing
# collapses to "unknown" rather than an error. The empty case covers three of
# them: no venv, a symlinked venv (reject_project_venv_symlink's rule, refused
# silently here instead of diagnosed), and a checkout with no reachable v* tag,
# such as a source download rather than a clone. The character class covers the
# fourth: core.tooling.version_cli prints digits and dots or nothing at all, so
# any other byte -- a warning on stdout, a second line -- is noise, not a
# version.
show_version() {
    _sv_version=''
    if [ ! -L "$BASE_DIR/venv" ] && [ -x "$BASE_DIR/venv/bin/python3" ]; then
        # The cd is load-bearing for the same sys.path reason documented at
        # catalog_cli in scripts/lib/common.sh: without it a working directory
        # holding its own "core" package turns a known version into "unknown".
        _sv_version="$(
            CDPATH='' cd -- "$BASE_DIR" || exit 0
            PYTHONPATH="$BASE_DIR/src" "$BASE_DIR/venv/bin/python3" \
                -m core.tooling.version_cli 2>/dev/null || true
        )"
    fi
    case "$_sv_version" in
        ''|*[!0-9.]*) _sv_version=unknown ;;
    esac
    printf '%s\n' "Scrooge Alert $_sv_version"
}

dispatch() {
    _d_command="$1"
    _d_owner="$2"
    shift 2
    # The managed-path symlink policy applied to the owner script itself: the
    # same fail-closed test as common.sh's require_regular_owned_file, plus -x,
    # inlined because there is no run_action here to route it through. It guards
    # every command rather than only the mutating ones, because exec hands the
    # process over and there is nothing left to refuse afterwards.
    if [ -L "$_d_owner" ] || [ ! -f "$_d_owner" ] || [ ! -x "$_d_owner" ]; then
        printf '\n%s\n\n' \
            "Error: Command owner is missing or unsafe: $_d_owner" >&2
        exit 1
    fi
    # Presentation context only: owners use this to select canonical
    # ./scrooge-alert help wording instead of direct-script wording.
    SCROOGE_PUBLIC_COMMAND="$_d_command"
    export SCROOGE_PUBLIC_COMMAND
    exec "$_d_owner" "$@"
}

if [ "$#" -eq 0 ]; then
    print_help
    exit 0
fi
if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help) print_help; exit 0 ;;
        --version) show_version; exit 0 ;;
    esac
fi

command_name="$1"
shift
# Every command's owner is scripts/<command>.sh, so one arm covers all ten. The
# pattern is the dispatch table: a name absent from it reaches fail_usage rather
# than a derived path, so the derivation never sees an unvalidated command name.
case "$command_name" in
    run|ping|status|install|enable|disable|stop|schedule|update|uninstall)
        dispatch "$command_name" "$BASE_DIR/scripts/$command_name.sh" "$@"
        ;;
    *)
        fail_usage "Unknown command: $command_name."
        ;;
esac
